# Public site URL (used in demo notification console logs)
# On GoDaddy, set this to your live domain, e.g. https://amoreglobaltravels.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Simple passcode for /agent inbox (client-visible; replace later with real auth)
NEXT_PUBLIC_AGENT_PASSCODE=amore-agents

# Shown in demo notification logs
NEXT_PUBLIC_AGENT_NOTIFY_EMAIL=info@amoreglobaltravels.com

# Leave unset on GoDaddy so assets load from the domain root.
# Set GITHUB_PAGES=true only for the GitHub Pages static deploy.
# GITHUB_PAGES=
