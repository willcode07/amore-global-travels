# Public site URL (used in emails and demo logs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# DEMO: leave DATA_BACKEND=local for GitHub Pages / no database
NEXT_PUBLIC_DATA_BACKEND=local

# Shown in notification copy (agent inbox address)
NEXT_PUBLIC_AGENT_NOTIFY_EMAIL=info@amoreglobaltravels.com

# Local / GitHub Pages demo only. API mode uses email OTP instead.
NEXT_PUBLIC_AGENT_PASSCODE=amore-agents

# Postgres (Neon or Docker). Leave as a placeholder until API mode.
# Local: postgresql://amore:amore@localhost:5432/amore
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Server-only signing secret for OTP cookies. Never NEXT_PUBLIC_*.
AUTH_SECRET=replace-with-a-long-random-string
AGENT_API_SECRET=replace-me

# Comma-separated agent inboxes allowed to request OTP. Use your email until Amore provides theirs.
AGENT_LOGIN_EMAILS=you@yourdomain.com

# Resend (leave blank to log emails and show demo OTP codes in the UI)
RESEND_API_KEY=
EMAIL_FROM=Amore Global <quotes@amoreglobaltravels.com>

# Cloudflare R2 (S3-compatible). Leave blank to keep pasting flyer URLs.
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_BUCKET=amore-quotes
R2_PUBLIC_BASE_URL=
