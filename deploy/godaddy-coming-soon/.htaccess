# Force HTTPS when the SSL certificate is active on this domain.
# GoDaddy Managed WP (Cloudflare gateway) may ignore DirectoryIndex and
# some RewriteCond forms — see .htaccess.log on the host. The MU plugin
# wp-content/mu-plugins/amore-coming-soon.php is the reliable hold.

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Root and WordPress front controller -> hold page.
  RewriteRule ^$ /index.html [L]
  RewriteRule ^index\.php$ /index.html [L]
</IfModule>
